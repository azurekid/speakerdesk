# ── Database ──────────────────────────────────────────────────────────────────
# Azure Database for PostgreSQL (Flexible Server) in production, e.g.
# postgresql://USER:PASSWORD@myserver.postgres.database.azure.com:5432/speakerdesk?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speakerdesk"

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (used for OAuth callbacks)
BETTER_AUTH_URL="http://localhost:3000"
# Email + password sign-in. Defaults to on in development, off in production.
# AUTH_EMAIL_PASSWORD="true"
# Brute-force limits (per IP and per email) are on in production, off in development. Override to test them:
# AUTH_RATE_LIMIT="true"

# Social providers — each one is enabled only when both values are set.
# Callback URL for each: {BETTER_AUTH_URL}/api/auth/callback/{provider}
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Microsoft Entra ID app registration. Use "common" to allow work + personal accounts.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ── Storage (headshots) ──────────────────────────────────────────────────────
# Azure Blob Storage. When unset, uploads are written to ./public/uploads (dev only).
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="headshots"
# Optional CDN / Front Door base URL that fronts the container, e.g. https://cdn.speakerdesk.app/headshots
AZURE_STORAGE_PUBLIC_BASE_URL=""

# ── Venue search ─────────────────────────────────────────────────────────────
# Azure Maps key for venue/address type-ahead. Without it, the free OpenStreetMap
# Photon service (photon.komoot.io) is used — fine for development and low volume.
AZURE_MAPS_KEY=""

# ── Email (passcodes, password resets, email changes) ────────────────────────
# Azure Communication Services Email. Without it, mail is only recorded in the
# admin Email outbox (/admin/outbox) — fine for development, not for production.
AZURE_COMMUNICATION_CONNECTION_STRING=""
EMAIL_FROM="DoNotReply@your-verified-domain.azurecomm.net"

# ── Platform admins ──────────────────────────────────────────────────────────
# Comma-separated emails that become platform admins when they sign up.
ADMIN_EMAILS=""
